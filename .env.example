# 复制本文件为 .env 后按需修改（.env 已加入 .gitignore，不会被提交）
# 也可以直接设置同名环境变量，优先级：环境变量 > .env > 内置演示默认值

# 应用账号（web 服务与 02/03/04 脚本使用）
DIABETES_DB_HOST=localhost
DIABETES_DB_PORT=3306
DIABETES_DB_NAME=diabetes_platform
DIABETES_DB_USER=diabetes_app
DIABETES_DB_PASSWORD=Diabetes@2026

# root 账号（仅 01_init_db.py 初始化建库建用户时使用）
DIABETES_DB_ROOT_USER=root
DIABETES_DB_ROOT_PASSWORD=
